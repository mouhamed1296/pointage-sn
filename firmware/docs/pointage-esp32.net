(export (version "E")
  (design
    (source "pointage-esp32")
    (date "2026-06-20")
    (tool "manuel — connectivite borne de pointage ESP32")
    (sheet (number "1") (name "/") (tstamps "/")))

  ;; Netlist de connectivite (format KiCad). Les broches sont referencees par
  ;; leur NOM (pas leur numero) a des fins de documentation. Pour un import
  ;; Pcbnew, associer les empreintes ci-dessous puis adapter les pads.

  (components
    (comp (ref "U1")  (value "ESP32-DevKitC-V4")     (footprint "RF_Module:ESP32-DevKitC-V4"))
    (comp (ref "U2")  (value "RC522")                 (footprint "Module:RC522_SPI"))
    (comp (ref "U3")  (value "AS608")                 (footprint "Module:AS608_UART"))
    (comp (ref "U4")  (value "SSD1306_OLED")          (footprint "Display:OLED_0.96_I2C"))
    (comp (ref "SW1") (value "Keypad_4x4")            (footprint "Keypad:Membrane_4x4"))
    (comp (ref "BZ1") (value "Buzzer_actif")          (footprint "Buzzer:Buzzer_12mm"))
    (comp (ref "D1")  (value "LED")                   (footprint "LED_THT:LED_D5.0mm"))
    (comp (ref "R1")  (value "220")                   (footprint "Resistor_THT:R_axial"))
    (comp (ref "PS1") (value "Alim_5V_2A")            (footprint "Connector:Barrel_Jack")))

  (nets
    (net (code "1") (name "+5V")
      (node (ref "PS1") (pin "+5V"))
      (node (ref "U1")  (pin "VIN")))
    (net (code "2") (name "+3V3")
      (node (ref "U1") (pin "3V3"))
      (node (ref "U2") (pin "VCC"))
      (node (ref "U3") (pin "VCC"))
      (node (ref "U4") (pin "VCC")))
    (net (code "3") (name "GND")
      (node (ref "PS1") (pin "GND"))
      (node (ref "U1")  (pin "GND"))
      (node (ref "U2")  (pin "GND"))
      (node (ref "U3")  (pin "GND"))
      (node (ref "U4")  (pin "GND"))
      (node (ref "BZ1") (pin "-"))
      (node (ref "D1")  (pin "K")))

    ;; --- SPI (RC522) ---
    (net (code "4") (name "SS_RFID")
      (node (ref "U1") (pin "IO5"))
      (node (ref "U2") (pin "SDA")))
    (net (code "5") (name "SPI_SCK")
      (node (ref "U1") (pin "IO18"))
      (node (ref "U2") (pin "SCK")))
    (net (code "6") (name "SPI_MOSI")
      (node (ref "U1") (pin "IO23"))
      (node (ref "U2") (pin "MOSI")))
    (net (code "7") (name "SPI_MISO")
      (node (ref "U1") (pin "IO19"))
      (node (ref "U2") (pin "MISO")))
    (net (code "8") (name "RST_RFID")
      (node (ref "U1") (pin "IO4"))
      (node (ref "U2") (pin "RST")))

    ;; --- I2C (OLED) ---
    (net (code "9") (name "I2C_SDA")
      (node (ref "U1") (pin "IO21"))
      (node (ref "U4") (pin "SDA")))
    (net (code "10") (name "I2C_SCL")
      (node (ref "U1") (pin "IO22"))
      (node (ref "U4") (pin "SCL")))

    ;; --- UART2 (AS608) ---
    (net (code "11") (name "FP_TX")
      (node (ref "U1") (pin "IO16"))
      (node (ref "U3") (pin "TX")))
    (net (code "12") (name "FP_RX")
      (node (ref "U1") (pin "IO17"))
      (node (ref "U3") (pin "RX")))

    ;; --- Clavier 4x4 ---
    (net (code "13") (name "KP_ROW1") (node (ref "U1") (pin "IO13")) (node (ref "SW1") (pin "R1")))
    (net (code "14") (name "KP_ROW2") (node (ref "U1") (pin "IO14")) (node (ref "SW1") (pin "R2")))
    (net (code "15") (name "KP_ROW3") (node (ref "U1") (pin "IO27")) (node (ref "SW1") (pin "R3")))
    (net (code "16") (name "KP_ROW4") (node (ref "U1") (pin "IO26")) (node (ref "SW1") (pin "R4")))
    (net (code "17") (name "KP_COL1") (node (ref "U1") (pin "IO25")) (node (ref "SW1") (pin "C1")))
    (net (code "18") (name "KP_COL2") (node (ref "U1") (pin "IO33")) (node (ref "SW1") (pin "C2")))
    (net (code "19") (name "KP_COL3") (node (ref "U1") (pin "IO32")) (node (ref "SW1") (pin "C3")))
    (net (code "20") (name "KP_COL4") (node (ref "U1") (pin "IO2"))  (node (ref "SW1") (pin "C4")))

    ;; --- Buzzer & LED ---
    (net (code "21") (name "BUZZER")
      (node (ref "U1")  (pin "IO15"))
      (node (ref "BZ1") (pin "+")))
    (net (code "22") (name "LED_ST")
      (node (ref "U1") (pin "IO12"))
      (node (ref "R1") (pin "1")))
    (net (code "23") (name "LED_ANODE")
      (node (ref "R1") (pin "2"))
      (node (ref "D1") (pin "A")))))
