# Port de l'API
PORT=3001

# Origine autorisée pour le frontend (CORS + WebSocket)
CORS_ORIGIN=http://localhost:5173

# Secret JWT (à changer en production !)
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# --- Base de données ---
# DB_TYPE = sqlite (défaut, zéro config) ou postgres (recommandé en prod 24/7)
DB_TYPE=sqlite
# SQLite :
DB_PATH=pointage.sqlite
# PostgreSQL (si DB_TYPE=postgres) :
DB_HOST=localhost
DB_PORT=5432
DB_USER=pointage
DB_PASSWORD=pointage
DB_NAME=pointage

# Compte administrateur créé automatiquement au démarrage s'il n'existe pas
ADMIN_EMAIL=admin@pointage.sn
ADMIN_PASSWORD=changeme
ADMIN_NAME=Administrateur
